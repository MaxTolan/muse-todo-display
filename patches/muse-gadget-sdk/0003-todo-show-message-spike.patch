diff --git a/esp32/main/app.c b/esp32/main/app.c
index 2cfb86a..1b91e3a 100644
--- a/esp32/main/app.c
+++ b/esp32/main/app.c
@@ -71,6 +71,9 @@
 #if CONFIG_MUSE_WATCHER_CAMERA
 #include "boards/watcher_camera.h"
 #endif
+#if CONFIG_TODO_DISPLAY
+#include "muse_state.h"
+#endif
 #if CONFIG_MUSE_ENABLED
 #include "muse_glue.h"
 // Muse joins Wi-Fi from its own settings, before or without pairing.
@@ -1895,6 +1898,23 @@ static cJSON *on_ws_command(
         return voice_configure_command(params);
     }
 #endif
+#if CONFIG_TODO_DISPLAY
+    if (strcmp(command, "todo.show_message") == 0) {
+        cJSON *text = params ? cJSON_GetObjectItem(params, "text") : NULL;
+        if (!cJSON_IsString(text) || !text->valuestring || !*text->valuestring) {
+            return command_error("invalid_params", "text is required");
+        }
+        if (strlen(text->valuestring) > 280) {
+            return command_error("invalid_params", "text too long (max 280)");
+        }
+        /* Spike: show it as the screen's caption; the todo screen replaces this. */
+        muse_state_set_caption("%s", text->valuestring);
+        ESP_LOGI(TAG, "todo.show_message: %s", text->valuestring);
+        cJSON *result = cJSON_CreateObject();
+        cJSON_AddBoolToObject(result, "ok", true);
+        return result;
+    }
+#endif
 #if CONFIG_HOMEHUB_SENSECAP_SENSORS
     if (strcmp(command, "sensors.read") == 0) {
         return sensecap_sensors_command();
