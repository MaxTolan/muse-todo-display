new file mode 100644
index 0000000..f182b69
--- /dev/null
+++ b/esp32/devices/sdkconfig.muse-waveshare-s3-lcd5
@@ -0,0 +1,35 @@
+# Copyright (c) Meta Platforms, Inc. and affiliates.
+# Licensed under the Apache License, Version 2.0.
+#
+# Waveshare ESP32-S3-Touch-LCD-5 (800x480): ESP32-S3, 16 MB flash, 8 MB
+# octal PSRAM, 800x480 RGB LCD and GT911 touch; USB-C on the chip's own USB
+# Serial/JTAG. A copy of the LCD-7 overlay. Source:
+# waveshareteam/ESP32-S3-Touch-LCD-5 (Arduino LVGL v9 demo board config).
+# Load after sdkconfig.defaults and sdkconfig.muse.
+CONFIG_IDF_TARGET="esp32s3"
+CONFIG_MUSE_BOARD_WAVESHARE_S3_LCD5=y
+CONFIG_HOMEHUB_BUTTON_GPIO=0
+CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
+CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
+CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
+CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
+
+CONFIG_SPIRAM=y
+CONFIG_SPIRAM_MODE_OCT=y
+CONFIG_SPIRAM_SPEED_80M=y
+CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
+CONFIG_SPIRAM_RODATA=y
+CONFIG_SPIRAM_XIP_FROM_PSRAM=y
+CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
+CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
+CONFIG_ESP32S3_DATA_CACHE_64KB=y
+CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
+CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
+CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
+CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
+CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
+CONFIG_SPIRAM_IGNORE_NOTFOUND=n
+
+# The RGB panel continuously scans its PSRAM frame buffer.
+CONFIG_LCD_RGB_RESTART_IN_VSYNC=y
+CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
