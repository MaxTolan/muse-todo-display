diff --git a/esp32/components/muse/muse_ext.h b/esp32/components/muse/muse_ext.h
new file mode 100644
index 0000000..59672f0
--- /dev/null
+++ b/esp32/components/muse/muse_ext.h
@@ -0,0 +1,43 @@
+/*
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ * Licensed under the Apache License, Version 2.0.
+ *
+ * Extension points for an app component built alongside the SDK (for
+ * example a screen that replaces the avatar, with its own commands). The
+ * component registers once, before the UI starts (e.g. from a constructor
+ * in a WHOLE_ARCHIVE component); every hook is optional.
+ */
+#pragma once
+
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct _lv_obj_t;
+struct cJSON;
+
+typedef struct {
+    /* After the SDK builds its UI, display lock held: add objects to the
+     * face tile (full screen, under the SDK's overlays). */
+    void (*ui_build)(struct _lv_obj_t *face);
+    /* Each UI frame, display lock held: true while the extension's own
+     * screen covers the avatar, so the SDK stops drawing it. */
+    bool (*ui_covers_face)(void);
+    /* Add commands to link.register: add(commands, ...) as noise_control does. */
+    void (*register_commands)(struct cJSON *commands);
+    /* Handle a link.invoke on the Noise task: a result, or NULL if not ours. */
+    struct cJSON *(*command)(const char *name, struct cJSON *params);
+    /* Every "@chat" line a typed turn reports (muse_hatch_console), from
+     * whichever task reports it: type, then the text (NULL if none). */
+    void (*chat_event)(const char *type, const char *text);
+} muse_ext_t;
+
+void muse_ext_register(const muse_ext_t *ext);
+/* The registered extension, or NULL. */
+const muse_ext_t *muse_ext(void);
+
+#ifdef __cplusplus
+}
+#endif
